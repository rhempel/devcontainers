#!/bin/bash
# -----------------------------------------------------------------------------
# build_image.sh - Builds a container image
#
# This script must be executed (not sourced) to avoid polluting the namespace
# of the calling shell ...
#
(return 0 2>/dev/null) && is_sourced=1 || is_sourced=0

if [ $is_sourced -ne 0 ]; then
  echo "$(basename ${BASH_SOURCE[0]}) must be executed, not sourced"
  unset is_sourced
  return 1
fi

show_help () {
cat << EOF
Usage: ${0##*/} [options]

Build a customized container image that can be used to create a container
instance.

  -t|--template       Container template folder name - default is "debian-13-slim"
  -c|--config CONFIG  Configuration to use - default is "default"
  -h|--help|\-?       Show this help text and exit
  --test              Dry run - print the generated podman command line
EOF
}

test_run=""

run () {
    if [ "${test_run}" ]; then
      echo "${0##*/}: $*"
    else 
      eval "$@"
    fi
}

build_image () {
  # Set reasonable defaults for key variables
  # 
  container_basename="${build_image_template_folder:-debian-13-slim}"
  container_tagname="${build_image_config_folder:-default}"
  container_user="${container_user:-${USER}}"

  run podman buildx build -t "${container_basename}":"${container_tagname}" \
                          --build-arg USER_NAME="${container_user}"\
                          --build-arg CONTAINER_CONFIG="${container_tagname}" \
                          devcontainers/templates/"${container_basename}"
}

main () {
  while [[ "$#" -gt 0 ]]; do
    case $1 in
      -t|--template) build_image_template_folder="$2"; shift ;;
      -c|--config)   build_image_config_folder="$2"; shift ;;
      -h|--help|-\?) show_help; return 0 ;;
      --test)        test_run="y" ;;
      *)             echo "Unknown parameter passed: $1"; return 1 ;;
    esac
    shift
  done
}

if main "$@"; then
  build_image
fi
