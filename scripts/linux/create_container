#!/bin/bash
# -----------------------------------------------------------------------------
# create_container.sh - Builds a container image
#
# This script must be executed (not sourced) to avoid polluting the namespace
# of the calling shell ...
#
(return 0 2>/dev/null) && is_sourced=1 || is_sourced=0

if [ $is_sourced -ne 0 ]; then
  echo "$(basename ${BASH_SOURCE[0]}) must be executed, not sourced"
  unset is_sourced
  return 1
fi

show_help () {
cat << EOF
Usage: ${0##*/} [options]

Create a container instance according to a configuration file.

  -t|--template       Container template folder name - default is "debian-13-slim"
  -c|--config CONFIG  Configuration to use - default is "default"
  -r|--replace        Replace the container instance if one already exists
  -h|--help|\-?       Show this help text and exit
  --test              Dry run - print the generated podman command line
EOF
}

test_run=""

run () {
    if [ "${test_run}" ]; then
      echo "${0##*/}: $*"
    else 
      eval "$@"
    fi
}

# -----------------------------------------------------------------------------
# create_container_options prefix map
#
create_container_options () {
  local prefix=$1
  local -n map=$2

  for item in "${map[@]}" ; do
    options+=" --${prefix} $item"
  done
  echo $options
}

create_container () {
  # Set reasonable defaults for key variables
  # 
  container_basename="${create_container_template_folder:-debian-13-slim}"
  container_tagname="${create_container_config_folder:-default}"
  container_user="${container_user:-${USER}}"

  # Build up the path for the container configuration template
  #
  create_container_template_path="$(dirname ${BASH_SOURCE[0]})/../.."
  create_container_template_path+="/templates/${create_container_template_folder}"
  create_container_template_path+="/configs/${create_container_config_folder}"

  source "${create_container_template_path}/container_variables.sh"

  # Create additional command line options for the container instance
  #
  container_hosts=$(create_container_options "add-host" container_host_maps)
  container_volumes=$(create_container_options "volume" container_volume_maps)
  container_publish=$(create_container_options "publish" container_port_maps)

  run podman create -it --userns=keep-id "${create_container_replace}" \
                        --name="${container_basename}"-"${container_tagname}" \
                        "${container_hosts}" \
                        "${container_volumes}" \
                        "${container_publish}" \
                        "${container_basename}":"${container_tagname}" \
                        /etc/devcontainer/postStartCommand 
}

main () {
  while [[ "$#" -gt 0 ]]; do
    case $1 in
      -t|--template) create_container_template_folder="$2"; shift ;;
      -c|--config)   create_container_config_folder="$2"; shift ;;
      -r|--replace)  create_container_replace="--replace" ;;
      -h|--help|-\?) show_help; return 0 ;;
      --test)        test_run="y" ;;
      *)             echo "Unknown parameter passed: $1"; return 1 ;;
    esac
    shift
  done
}

if main "$@"; then
  create_container
fi
