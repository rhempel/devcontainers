#!/bin/bash
#
# This command is executed as root, just before the user is switched
# to actual container user

ln -s /etc/devcontainer/postAttachCommand /etc/profile.d/99postAttachCommand.sh

date >> /tmp/postCreateCommand.log

# Now install everything we need to run sphinx - use Debian
# python3 packages if possible
#
apt update && \
apt install --no-install-recommends -y \
    ca-certificates \
    tzdata \
    locales \
    git \
    ssh \
    make \
    python3 \
    python3-pip \
    python3-clang \
    python3-sphinx \
    python3-sphinx-rtd-theme \
    python3-sphinxcontrib.plantuml \
    graphviz \
    default-jre \
    vim \
    wget

